# SecretDrop — variables de entorno
#
# Copia este fichero a `.env.local` y rellena los valores. Sin `SESSION_SECRET`
# y sin cliente OIDC no se puede crear ningún secreto: es deliberado.
#
# Ojo: leer un secreto NO exige cuenta, y así debe ser — quien recibe el enlace
# no tiene por qué tenerla. Solo crear y listar están protegidos.

# Firma las cookies de sesión. Genérala con:
#   openssl rand -hex 32
# Cambiarla invalida todas las sesiones abiertas.
SECRETDROP_SESSION_SECRET=

# ─── Proveedor de identidad (OIDC) ──────────────────────────────────────
SECRETDROP_OIDC_CLIENT_ID=
SECRETDROP_OIDC_CLIENT_SECRET=

# Tiene que coincidir exactamente con la registrada en el proveedor.
SECRETDROP_OIDC_REDIRECT_URI=https://ejemplo.tudominio.com/api/auth/callback

# PUBLIC   la que ve el navegador de quien inicia sesión.
# INTERNAL la que usa este servidor para canjear el código. Si el proveedor
#          corre en la misma máquina, apuntarla a loopback evita salir a
#          internet y volver.
SECRETDROP_OIDC_PUBLIC_BASE=https://auth.tudominio.com
SECRETDROP_OIDC_INTERNAL_BASE=http://127.0.0.1:9100

# Slug con el que la aplicación está dada de alta en el proveedor. Solo lo usa
# el cierre de sesión. Por defecto: secretdrop
#SECRETDROP_OIDC_APP_SLUG=secretdrop
