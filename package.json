{
  "name": "secretdrop",
  "version": "0.8.0",
  "description": "One-time secret sharing, encrypted in the browser: the key travels in the URL fragment and the server only ever sees ciphertext.",
  "license": "MIT",
  "author": "Ulzuhan",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ulzuhan/secretdrop.git"
  },
  "keywords": [
    "secrets",
    "one-time",
    "burn-after-reading",
    "encryption",
    "webcrypto",
    "self-hosted",
    "nextjs"
  ],
  "private": true,
  "scripts": {
    "dev": "next dev -p 3461",
    "build": "next build",
    "start": "next start -p 3461",
    "lint": "eslint",
    "test": "vitest run && ./scripts/run-suites.sh",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:http": "./scripts/run-suites.sh",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "test:backchannel": "bash scripts/test-backchannel.sh",
    "test:reinicio": "bash scripts/test-reinicio.sh",
    "test:navegador": "bash scripts/test-navegador.sh",
    "build:web": "vite build",
    "test:compatibilidad": "bash scripts/test-compatibilidad.sh"
  },
  "dependencies": {
    "next": "^16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "postcss": "^8.5.18",
    "nanoid": "3.3.18",
    "js-yaml": "^4.3.1",
    "brace-expansion": "^2.0.2"
  }
}
