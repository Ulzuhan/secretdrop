{
  "name": "secretdrop",
  "version": "0.8.0",
  "description": "One-time secret sharing, encrypted in the browser: the key travels in the URL fragment and the server only ever sees ciphertext.",
  "license": "MIT",
  "author": "Ulzuhan",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ulzuhan/secretdrop.git"
  },
  "keywords": [
    "secrets",
    "one-time",
    "burn-after-reading",
    "encryption",
    "webcrypto",
    "self-hosted",
    "golang",
    "react"
  ],
  "private": true,
  "scripts": {
    "dev": "npm run build && bash scripts/dev.sh",
    "build": "npm run build:web && go build -trimpath -o secretdrop ./cmd/secretdrop",
    "start": "./secretdrop",
    "lint": "eslint .",
    "test": "npm run build && npm run test:unit && npm run test:go && npm run test:http && npm run test:backchannel && npm run test:reinicio",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:http": "./scripts/run-suites.sh",
    "test:backchannel": "bash scripts/test-backchannel.sh",
    "test:reinicio": "bash scripts/test-reinicio.sh",
    "test:navegador": "bash scripts/test-navegador.sh",
    "build:web": "vite build",
    "test:compatibilidad": "bash scripts/test-compatibilidad.sh",
    "typecheck": "tsc --noEmit",
    "test:go": "go test -race ./cmd/... ./internal/..."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5",
    "typescript-eslint": "^8.59.4",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "nanoid": "3.3.18",
    "js-yaml": "^4.3.1",
    "brace-expansion": "^2.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
